# Copy to .env and fill in. .env is gitignored and never committed.
# The harness loads .env with override=True, so this key wins over any
# ANTHROPIC_API_KEY already exported in your shell.
ANTHROPIC_API_KEY=

# Hugging Face token (exps 7 and 8) with the Gemma 3 license accepted.
HF_TOKEN=

# Modal profile from ~/.modal.toml to use for this project.
MODAL_PROFILE=
